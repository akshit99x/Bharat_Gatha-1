{
  "name": "bharat-gatha",
  "private": true,
  "version": "0.1.0",
  "description": "Bharat Gatha - an open-world first-person learning game about Indian civilisation, history and culture. Smart India Hackathon PS 26208.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "voices:script": "node scripts/voices.mjs script",
    "voices:import": "node scripts/voices.mjs import",
    "voices:manifest": "node scripts/voices.mjs manifest",
    "voices:check": "node scripts/voices.mjs check",
    "content:export": "node scripts/export-content.mjs",
    "api:dev": "python3 -m uvicorn server.app:app --reload --port 8000",
    "api:test": "python3 -m pytest -q",
    "content:report": "python3 -m tools.content_report"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
